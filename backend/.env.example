# Application
APP_NAME="FormCraft API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://formcraft:formcraft_password@db:5432/formcraft

# Security — CHANGE THESE IN PRODUCTION
SECRET_KEY=your-super-secret-key-change-this-in-production-must-be-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — comma-separated, no spaces
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:4173"]

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# API key used to protect admin endpoints in dev (JWT-less mode)
API_KEY=dev-api-key-change-in-production
